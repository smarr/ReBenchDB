{
  "name": "rebenchdb",
  "version": "0.6.0",
  "description": "A Web-Based Database for ReBench Results",
  "main": "index.js",
  "author": {
    "name": "Stefan Marr",
    "email": "git@stefan-marr.de"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@koa/router": "15.7.0",
    "@octokit/auth-app": "8.3.0",
    "@octokit/rest": "22.0.1",
    "@sgratzl/chartjs-chart-boxplot": "4.4.5",
    "canvas": "3.2.3",
    "chart.js": "4.5.1",
    "chartjs-plugin-annotation": "3.1.0",
    "decimal.js": "10.6.0",
    "ejs": "6.0.1",
    "join-images": "1.1.5",
    "koa": "3.2.1",
    "koa-body": "8.0.0",
    "pg": "8.23.0",
    "promisify-child-process": "5.0.1",
    "sharp": "0.35.3",
    "tslog": "5.1.0",
    "uplot": "1.6.32"
  },
  "overrides": {
    "join-images": {
      "sharp": "$sharp"
    },
    "test-exclude": "^7.0.1"
  },
  "engines": {
    "node": ">=21.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@octokit/types": "17.0.0",
    "@types/jquery": "4.0.1",
    "@types/koa": "3.0.3",
    "@types/koa__router": "12.0.5",
    "@types/pg": "8.21.0",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "ajv": "8.20.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.0",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.9.0",
    "jest": "30.4.2",
    "nodemon": "3.1.14",
    "patch-package": "8.0.1",
    "pixelmatch": "7.2.0",
    "prettier": "3.9.6",
    "source-map-support": "0.5.21",
    "terser": "5.49.2",
    "ts-jest": "29.4.12",
    "typescript-eslint": "8.67.0",
    "typescript-json-schema": "0.68.0"
  },
  "jest": {
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "text",
      [
        "text-summary",
        {
          "file": "coverage-summary.txt"
        }
      ]
    ],
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "testPathIgnorePatterns": [
      "<rootDir>/dist/",
      "<rootDir>/node_modules/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "/static/uPlot.esm.min.js": "<rootDir>/resources/uPlot.esm.min.js"
    },
    "roots": [
      "tests/"
    ]
  },
  "scripts": {
    "postinstall": "if [ -z \"${SKIP_COMPILE}\" ]; then npm run compile; fi; patch-package",
    "precompile": "npm run prep-folders && npm run compile-uplot",
    "prep-folders": "mkdir -p tmp/interm tmp/knit resources/reports resources/exp-data",
    "compile-uplot": "terser --module --ecma 2018 --compress --mangle -o ./resources/uPlot.esm.min.js -- node_modules/uplot/dist/uPlot.esm.js",
    "compile": "tsgo",
    "postcompile": "npm run prep-static && npm run download-font",
    "prep-static": "cp dist/src/frontend/*.js dist/src/shared/*.js ./resources/",
    "download-font": "if ! [ -f dist/roboto-hinted/Roboto-Black.ttf ]; then node dist/src/download.js https://github.com/googlefonts/roboto/releases/download/v2.136/roboto-hinted.zip tmp/roboto-hinted.zip && unzip -DD -o -d dist tmp/roboto-hinted.zip; fi",
    "start": "node --enable-source-maps --experimental-json-modules ./dist/src/index.js",
    "nodemon": "DEV=true nodemon --enable-source-maps --experimental-json-modules ./dist/src/index.js --watch ./dist/src --watch ./package.json --watch ./src --ext js,json,html",
    "format": "prettier --config .prettierrc '{src,tests}/**/*.ts' --write",
    "check-format": "prettier --config .prettierrc '{src,tests}/**/*.ts' --check",
    "verify": "npm run lint && npm run check-format",
    "lint": "eslint . --ext .ts,.tsx",
    "update": "git pull && npm install . && pm2 restart 0",
    "watch": "tsgo -w",
    "pretest": "(cd tests/data; bzip2 -d -f -k large-payload.json.bz2; mkdir -p actual-results/charts; mkdir -p actual-results/stats-data-prep; mkdir -p actual-results/compare-view)",
    "test": "node --no-warnings --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "update-expected-results": "UPDATE_EXPECTED_DATA=true npm test"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "canvas@3.2.3": true
  }
}
